{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edopro-retro-formats/schemas/card-index.schema.json",
  "title": "Card index",
  "description": "A minimal, generated index of every card referenced anywhere in this repository's data. It exists so the validator can cross-check passcode<->name pairs and aliases without shipping a full card database. Regenerated by tools/import/from_babelcdb.py; never hand-edited.",
  "type": "object",
  "required": ["generated_by", "source", "cards"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "generated_by": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["repository", "revision"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "revision": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["passcode", "name"],
        "additionalProperties": false,
        "properties": {
          "passcode": { "$ref": "common.schema.json#/$defs/passcode" },
          "name": { "type": "string" },
          "alias_of": {
            "oneOf": [{ "$ref": "common.schema.json#/$defs/passcode" }, { "type": "null" }],
            "description": "The cdb 'alias' value when non-zero: the code this card counts as for deck-building limits."
          },
          "ot": { "type": "integer", "description": "Scope bitfield as stored in the source cdb (OCG/TCG/custom...)." }
        }
      }
    }
  }
}
