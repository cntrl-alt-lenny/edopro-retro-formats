# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Import caches: raw downloaded/scraped material is never committed.
# Canonical data lives in data/ with provenance; regenerate caches with tools/import.
.cache/
cache/
*.cdb
!dist/databases/*.cdb

# Editor noise
.vscode/
.idea/
*.swp
.DS_Store

# Per-role nested git worktrees (see AGENTS.md § Checkouts and
# docs/agents/git-and-isolation.md) -- real working directories git tracks
# via .git/worktrees/, not project output. Kept out of `git status` noise in
# the primary checkout. The retired pre-adoption location stays ignored so an
# old clone's leftover checkout does not show up as untracked content.
.worktrees/
.claude/worktrees/
